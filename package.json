{
  "name": "sh-analysis",
  "version": "0.1.1",
  "description": "Facts about shell scripts from the sh-ast syntax tree: word resolution, every command site, wrapper chains (sudo, env, nice) and embedded interpreter programs, with explicit uncertainty.",
  "keywords": [
    "shell",
    "bash",
    "zsh",
    "posix",
    "sh",
    "static-analysis",
    "ast",
    "command",
    "argv",
    "lint",
    "sh-ast"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/sh-analysis.git"
  },
  "homepage": "https://github.com/mike-north/sh-analysis#readme",
  "bugs": {
    "url": "https://github.com/mike-north/sh-analysis/issues"
  },
  "engines": {
    "node": "^22.14.0 || >=24"
  },
  "packageManager": "pnpm@11.12.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "concurrently --success all --names types,lint,api,knip,syncpack \"pnpm check:typecheck\" \"pnpm check:lint-ts\" \"pnpm check:api-report\" \"pnpm check:knip\" \"pnpm check:syncpack\" && pnpm check:test-types && pnpm test:types && pnpm check:format",
    "test": "pnpm test:contracts && pnpm test:analysis && pnpm test:types",
    "check:release": "node --experimental-strip-types scripts/check-release.ts",
    "check:changesets": "node --experimental-strip-types scripts/check-changesets.ts",
    "check:versions": "node --experimental-strip-types scripts/check-versions.ts",
    "version-packages": "pnpm check:changesets && pnpm check:versions && changeset version && pnpm check:versions",
    "release": "pnpm build && pnpm check && pnpm test && pnpm check:release && changeset publish",
    "check:typecheck": "tsc -p tsconfig.json --noEmit",
    "check:lint-ts": "eslint . --max-warnings 0",
    "check:api-report": "api-extractor run",
    "check:knip": "knip",
    "check:syncpack": "syncpack lint",
    "build:docs": "api-extractor run --local && api-documenter markdown -i temp -o docs/api && prettier --write docs/api",
    "fix:lint-ts": "eslint . --fix",
    "fix:format": "prettier --write .",
    "test:contracts": "node --experimental-strip-types --test test/*.test.ts",
    "test:analysis": "vitest run --maxWorkers=2",
    "test:types": "tsd",
    "check:format": "prettier --check .",
    "check:test-types": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@changesets/assemble-release-plan": "7.0.0",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@changesets/pre": "3.0.0",
    "@changesets/read": "1.0.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@manypkg/get-packages": "3.1.0",
    "@microsoft/api-documenter": "7.30.7",
    "@microsoft/api-extractor": "7.58.9",
    "@types/node": "22.19.0",
    "@types/semver": "7.7.1",
    "concurrently": "10.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.6.1",
    "knip": "6.26.0",
    "prettier": "^3.9.10",
    "semver": "7.8.6",
    "syncpack": "15.3.2",
    "tsd": "^0.33.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "^4.1.12",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "sh-ast": "^0.11.0"
  },
  "types": "./dist/index.d.ts",
  "author": "Mike North <michael.l.north@gmail.com>"
}
