{
  "name": "sh-analysis",
  "version": "0.0.0-stage",
  "description": "Shell word and command observations over the public sh-ast syntax model",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/sh-analysis.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.12.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "yaml": "^2.8.1"
  }
}
