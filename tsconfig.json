{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "noImplicitAny": true,
    "jsx": "preserve",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noEmitOnError": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src/**/*", "test/**/*", "*.ts", "scripts/**/*.ts"],
  "exclude": ["test-d"]
}
